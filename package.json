{
  "name": "tradeintra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests *.ts *.mts *.cjs *.json",
    "format:check": "prettier --check app components lib scripts tests *.ts *.mts *.cjs *.json",
    "start:cpanel": "node server.cjs",
    "poc:migrate": "tsx --env-file-if-exists=.env.poc scripts/poc-migrate.ts",
    "poc:seed": "tsx --env-file-if-exists=.env.poc scripts/poc-seed.ts",
    "poc:check": "tsx --env-file-if-exists=.env.poc scripts/poc-check.ts",
    "poc:cron": "tsx --env-file-if-exists=.env.poc scripts/poc-cron.ts",
    "poc:smoke": "node scripts/poc-runtime-smoke.mjs",
    "studio:migrate": "tsx --env-file-if-exists=.env.studio scripts/studio-migrate.ts",
    "package:cpanel": "npm run build && node scripts/package-release.mjs && node scripts/verify-release.mjs",
    "provider:check": "node scripts/provider-check.mjs",
    "host:check": "tsx --env-file-if-exists=.env.studio scripts/host-check.ts",
    "account:purge": "tsx scripts/account-deletion.ts",
    "signals:deliver": "tsx scripts/signal-delivery.ts",
    "monitor": "tsx scripts/monitor.ts",
    "backup:db": "bash scripts/backup-database.sh"
  },
  "dependencies": {
    "kysely": "^0.29.7",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
