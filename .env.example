# Browser-local studio works without these values. Never commit actual .env files.
# Development-only mock operations (domains, billing, bots, signals, admin) are
# shown by default in `next dev`. For a built preview, set NEXT_PUBLIC_MOCK_OPS=true.
# Never enable this on a production customer host.
# NEXT_PUBLIC_MOCK_OPS=true
# Enable only on an owner-approved staging environment. No live integrations supported.
DERIV_MODE=mock
FEATURE_LIVE_DERIV=false
FEATURE_PAYMENT_AGENT=false
POC_ENABLED=false

# Use a dedicated staging database and a NON-superuser role WITHOUT BYPASSRLS.
# Set the actual value securely in cPanel; never paste it into logs or chat.
DATABASE_URL=
# Lowercase hostnames WITHOUT ports. Replace only with explicitly approved test hosts.
# Host assignments are seeded explicitly; they are never automatically provisioned.
POC_HOSTS='{"aurora.staging.example.test":"aurora","nova.staging.example.test":"nova","orbit.staging.example.test":"orbit","custom.example.test":"aurora"}'
# Absolute private directory OUTSIDE this checkout and public_html, mode 0700.
STORAGE_ROOT=
# Optional production-style tenant routing. Free subdomains resolve to published
# snapshots; custom domains require an active host_mappings row.
# TENANT_HOST_SUFFIX=tradeintra.com
# TENANT_CUSTOM_HOSTS=false
# cPanel supplies PORT; defaults to 3000 for a local built server.
PORT=3000

# Server-backed development studio (separate from diagnostic POC fixtures).
# `npm run dev` defaults to a private LOCAL development database, no provider needed.
# Built/production runtimes default to disabled. PostgreSQL is only enabled on
# explicitly approved staging with the variables below; no silent DB fallback.
# STUDIO_DB_MODE=local
# STUDIO_ENV=local
# STUDIO_DATA_DIR=/absolute/private/local-directory-outside-checkout
# For staging only, configure securely and apply database/002-studio.sql explicitly:
# STUDIO_DB_MODE=postgres
# STUDIO_ENV=staging
# STUDIO_ENABLED=true
# APP_URL=https://your-approved-staging-host.example.test
# DATABASE_URL=(set securely; never commit the actual URL)

# Production provider adapters (mock/sandbox/live until supplied).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://tradeintra.com/api/auth/google/callback
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_USERNAME=
# NAMECHEAP_CLIENT_IP=
# NAMECHEAP_ENV=sandbox
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_CALLBACK_SECRET=
# MPESA_ALLOWED_IPS=
# MPESA_USD_KES_RATE=130
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_MODE=mock
# TELEGRAM_MODE=mock
# TELEGRAM_BOT_TOKEN=
# DERIV_CLIENT_ID=
# DERIV_CLIENT_SECRET=
# DERIV_REDIRECT_URI=
# DERIV_APP_ID=
# SUPER_ADMIN_EMAILS=
# FINANCE_EMAILS=
# SUPPORT_EMAILS=
# MCP_API_KEY=
# CRON_SECRET=
# MARKETPLACE_SCAN_MODE=basic
# CLAMSCAN_PATH=
# TOKEN_ENCRYPTION_KEY=   # 32 bytes, base64
# STORAGE_ROOT=/absolute/private/storage-outside-web-root
# PROVIDER_MODE=mock
